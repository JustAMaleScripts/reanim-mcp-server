  "description": "MCP server for Nooby's uh modded reanimation (reanim.luau) - dances, movesets, UI themes, keybinds, module scaffolding, RootPart plugins and more",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
